+++ b/OvmfPkg/VirtMmCommunicationDxe/Svsm.c
@@ -5,6 +5,7 @@
 **/
 
 #include <Library/BaseLib.h>
+#include <Library/MemEncryptSevLib.h>
 
 #include <Library/AmdSvsmLib.h>
 #include <Register/Amd/Msr.h>
@@ -22,6 +23,13 @@
 {
   UINT32  Min, Max;
 
+  // On an ordinary VM this address is not an SNP secrets page. In
+  // particular, RAM from the previous OS survives a warm reboot.
+  // Do not mistake its contents for SVSM metadata or issue VMGEXIT.
+  if (!MemEncryptSevSnpIsEnabled ()) {
+    return FALSE;
+  }
+
   if (!AmdSvsmIsSvsmPresent ()) {
     DEBUG ((DEBUG_VERBOSE, "%a: no SVSM present\n", __func__));
     return FALSE;
